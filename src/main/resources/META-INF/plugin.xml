<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.bnsoft.chromabox</id>
    <name>Chromabox</name>
    <vendor>bnsoft</vendor>

    <description><![CDATA[
        <img src="https://raw.githubusercontent.com/nbu/chromabox/main/docs/chromabox-banner.png" width="1280" height="800" alt="Chromabox"/><br>
        Shows color swatches next to colors in any text file, such as Markdown, CSV, JSON, YAML or source code.<br>
        Click a swatch to pick a new color; it's written back in the notation the color was written in.<br>
        Formats, each with its own setting:
        <ul>
          <li>Hex: <code>#f00</code>, <code>#1E90FF</code>, <code>#1E90FF80</code></li>
          <li>CSS functions: <code>rgb(255, 0, 0)</code>, <code>rgb(255 0 0 / 50%)</code>, <code>hsl()</code>, <code>hwb()</code></li>
          <li>CSS Color 4: <code>oklch(70% 0.1 200)</code>, <code>oklab()</code>, <code>lab()</code>, <code>lch()</code>, <code>color(display-p3 1 0 0)</code></li>
          <li>Integer colors: <code>0xFFAABBCC</code></li>
          <li>Language constructors: Compose and Flutter <code>Color(0xFF112233)</code>, AWT <code>new Color(1, 2, 3)</code>,
            UIKit and SwiftUI <code>UIColor(red: 0.1, green: 0.2, blue: 0.3, alpha: 1)</code></li>
          <li>Named colors (off by default): <code>tomato</code>, <code>rebeccapurple</code></li>
          <li>Float tuples (off by default): <code>[0.1, 0.2, 0.3]</code></li>
        </ul>
        Display modes: swatch only, swatch with the color text, or off (<em>View | Chromabox</em> or
        <em>Settings | Tools | Chromabox</em>).<br>
        Colors the IDE already shows a swatch for are skipped, and so are CSS-like files by default.
        ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <resource-bundle>messages.ChromaboxBundle</resource-bundle>

    <extensionPoints>
        <!-- Registration order decides ties between overlapping matches of the same length. -->
        <extensionPoint qualifiedName="com.bnsoft.chromabox.lens"
                        interface="com.bnsoft.chromabox.engine.Lens"
                        dynamic="true"/>
    </extensionPoints>

    <extensions defaultExtensionNs="com.bnsoft.chromabox">
        <lens implementation="com.bnsoft.chromabox.HexColorLens"/>
        <lens implementation="com.bnsoft.chromabox.CssFunctionColorLens"/>
        <lens implementation="com.bnsoft.chromabox.CssColor4Lens"/>
        <lens implementation="com.bnsoft.chromabox.IntegerColorLens"/>
        <lens implementation="com.bnsoft.chromabox.ConstructorColorLens"/>
        <lens implementation="com.bnsoft.chromabox.NamedColorLens"/>
        <lens implementation="com.bnsoft.chromabox.FloatTupleLens"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij">
        <errorHandler implementation="com.intellij.diagnostic.JetBrainsMarketplaceErrorReportSubmitter"/>
        <editorFactoryListener implementation="com.bnsoft.chromabox.ChromaboxEditorFactoryListener"/>
        <applicationConfigurable parentId="tools"
                                 id="com.bnsoft.chromabox.settings"
                                 instance="com.bnsoft.chromabox.ChromaboxConfigurable"
                                 bundle="messages.ChromaboxBundle"
                                 key="settings.title"/>
    </extensions>

    <applicationListeners>
        <listener class="com.bnsoft.chromabox.ChromaboxDynamicPluginListener"
                  topic="com.intellij.ide.plugins.DynamicPluginListener"/>
    </applicationListeners>

    <actions>
        <group id="Chromabox.DisplayMode" popup="true">
            <action id="Chromabox.Mode.BoxOnly" class="com.bnsoft.chromabox.BoxOnlyModeAction"/>
            <action id="Chromabox.Mode.BoxWithHex" class="com.bnsoft.chromabox.BoxWithHexModeAction"/>
            <action id="Chromabox.Mode.Off" class="com.bnsoft.chromabox.OffModeAction"/>
            <separator/>
            <action id="Chromabox.CycleMode" class="com.bnsoft.chromabox.CycleDisplayModeAction"/>
            <add-to-group group-id="ViewMenu" anchor="last"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </group>
    </actions>
</idea-plugin>
