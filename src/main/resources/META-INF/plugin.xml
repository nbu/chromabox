<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.bnsoft.chromabox</id>
    <name>Chromabox</name>
    <vendor>bnsoft</vendor>

    <description><![CDATA[
        <img src="https://raw.githubusercontent.com/nbu/chromabox/main/docs/chromabox-banner.png" width="480" height="300" alt="Chromabox"/><br>
        Color swatches next to colors in any text file, such as Markdown, YAML, JSON, CSV or source code. Click a swatch
        to pick a new color; it's written back in the notation it was written in, and one undo reverts it.
        <br><img src="https://raw.githubusercontent.com/nbu/chromabox/main/docs/screenshots/editor.png" width="480" height="300" alt="Swatches, contrast badges and the Chromabox tool window"/>

        <h3>Formats</h3>
        Each with its own setting:
        <ul>
          <li>Hex: <code>#f00</code>, <code>#1E90FF</code>, <code>#1E90FF80</code></li>
          <li>CSS functions: <code>rgb(255, 0, 0)</code>, <code>rgb(255 0 0 / 50%)</code>, <code>hsl()</code>, <code>hwb()</code></li>
          <li>CSS Color 4: <code>oklch(70% 0.1 200)</code>, <code>oklab()</code>, <code>lab()</code>, <code>lch()</code>, <code>color(display-p3 1 0 0)</code></li>
          <li>Integer colors: <code>0xFFAABBCC</code></li>
          <li>Language constructors: Compose and Flutter <code>Color(0xFF112233)</code>, AWT <code>new Color(1, 2, 3)</code>,
            UIKit and SwiftUI <code>UIColor(red: 0.1, green: 0.2, blue: 0.3, alpha: 1)</code></li>
          <li>CSS gradients, as one wide swatch; click it to edit a stop</li>
          <li>Off by default: named colors (<code>tomato</code>), float tuples (<code>[0.1, 0.2, 0.3]</code>), and a strip
            after three or more colors in a row</li>
        </ul>

        <h3>Contrast</h3>
        Colors that belong together, such as <code>fg</code> and <code>bg</code> keys or two colors on one line, get a badge
        with their WCAG ratio: <code>4.6:1 AA</code>. Hover it for details, APCA if you like, and a <b>Fix</b> that adjusts
        the foreground's lightness until it passes.
        <br><img src="https://raw.githubusercontent.com/nbu/chromabox/main/docs/screenshots/contrast.png" width="480" height="300" alt="The contrast popup"/>

        <h3>The Chromabox tool window</h3>
        Every color in a file, the open files, the project or any scope, with usage counts. Find usages, copy as another
        notation, or replace a color everywhere, each occurrence in its own notation. Colors that look nearly the same are
        grouped, and a group can be merged into one color after a preview. Export the palette as JSON, CSS custom
        properties, a GIMP palette or a Markdown table.
        <br><img src="https://raw.githubusercontent.com/nbu/chromabox/main/docs/screenshots/merge.png" width="480" height="300" alt="Merging near-duplicate colors"/>

        <h3>And</h3>
        <ul>
          <li>Swatches in the Markdown preview.</li>
          <li><em>Simulate Color Vision</em>: swatches and contrast badges as people with protanopia, deuteranopia,
            tritanopia or achromatopsia see them.</li>
          <li>Display modes: swatch only, swatch with the color text, gutter icons, or off (<em>View | Chromabox</em>).</li>
        </ul>
        Colors the IDE already shows a swatch for are skipped, and so are CSS-like files by default. No network access.
        ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends optional="true" config-file="chromabox-markdown.xml">org.intellij.plugins.markdown</depends>

    <resource-bundle>messages.ChromaboxBundle</resource-bundle>

    <extensionPoints>
        <!-- Registration order decides ties between overlapping matches of the same length. -->
        <extensionPoint qualifiedName="com.bnsoft.chromabox.lens"
                        interface="com.bnsoft.chromabox.engine.Lens"
                        dynamic="true"/>
    </extensionPoints>

    <extensions defaultExtensionNs="com.bnsoft.chromabox">
        <lens implementation="com.bnsoft.chromabox.HexColorLens"/>
        <lens implementation="com.bnsoft.chromabox.CssFunctionColorLens"/>
        <lens implementation="com.bnsoft.chromabox.CssColor4Lens"/>
        <lens implementation="com.bnsoft.chromabox.IntegerColorLens"/>
        <lens implementation="com.bnsoft.chromabox.ConstructorColorLens"/>
        <lens implementation="com.bnsoft.chromabox.NamedColorLens"/>
        <lens implementation="com.bnsoft.chromabox.FloatTupleLens"/>
        <lens implementation="com.bnsoft.chromabox.GradientLens"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij">
        <errorHandler implementation="com.intellij.diagnostic.JetBrainsMarketplaceErrorReportSubmitter"/>
        <editorFactoryListener implementation="com.bnsoft.chromabox.ChromaboxEditorFactoryListener"/>
        <toolWindow id="Chromabox" anchor="right" secondary="true" icon="/icons/chromaboxToolWindow.svg"
                    factoryClass="com.bnsoft.chromabox.palette.PaletteToolWindowFactory"/>
        <fileBasedIndex implementation="com.bnsoft.chromabox.palette.ColorIndex"/>
        <postStartupActivity implementation="com.bnsoft.chromabox.palette.ColorIndexStartup"/>
        <notificationGroup id="Chromabox" displayType="BALLOON" bundle="messages.ChromaboxBundle" key="notification.group"/>
        <statusBarWidgetFactory id="Chromabox.ColorVision" implementation="com.bnsoft.chromabox.ColorVisionWidgetFactory"/>
        <applicationConfigurable parentId="tools"
                                 id="com.bnsoft.chromabox.settings"
                                 instance="com.bnsoft.chromabox.ChromaboxConfigurable"
                                 bundle="messages.ChromaboxBundle"
                                 key="settings.title"/>
    </extensions>

    <applicationListeners>
        <listener class="com.bnsoft.chromabox.ChromaboxDynamicPluginListener"
                  topic="com.intellij.ide.plugins.DynamicPluginListener"/>
        <listener class="com.bnsoft.chromabox.palette.ColorIndexSettingsListener"
                  topic="com.bnsoft.chromabox.ChromaboxSettingsListener"/>
    </applicationListeners>

    <actions>
        <group id="Chromabox.DisplayMode" popup="true">
            <action id="Chromabox.Mode.BoxOnly" class="com.bnsoft.chromabox.BoxOnlyModeAction"/>
            <action id="Chromabox.Mode.BoxWithHex" class="com.bnsoft.chromabox.BoxWithHexModeAction"/>
            <action id="Chromabox.Mode.Gutter" class="com.bnsoft.chromabox.GutterModeAction"/>
            <action id="Chromabox.Mode.Off" class="com.bnsoft.chromabox.OffModeAction"/>
            <separator/>
            <action id="Chromabox.CycleMode" class="com.bnsoft.chromabox.CycleDisplayModeAction"/>
            <separator/>
            <action id="Chromabox.CheckContrast" class="com.bnsoft.chromabox.CheckContrastAction"/>
            <group id="Chromabox.Simulate" popup="true">
                <action id="Chromabox.Simulate.None" class="com.bnsoft.chromabox.SimulateNoneAction"/>
                <separator/>
                <action id="Chromabox.Simulate.Protanopia" class="com.bnsoft.chromabox.SimulateProtanopiaAction"/>
                <action id="Chromabox.Simulate.Deuteranopia" class="com.bnsoft.chromabox.SimulateDeuteranopiaAction"/>
                <action id="Chromabox.Simulate.Tritanopia" class="com.bnsoft.chromabox.SimulateTritanopiaAction"/>
                <action id="Chromabox.Simulate.Achromatopsia" class="com.bnsoft.chromabox.SimulateAchromatopsiaAction"/>
            </group>
            <add-to-group group-id="ViewMenu" anchor="last"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </group>
    </actions>
</idea-plugin>
